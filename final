</div>

<style>
.field-wrap{margin-bottom:12px;}
.field-lbl{font-family:'Nunito',sans-serif;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#1976d2;display:block;margin-bottom:5px;}
#rsvp-form input[type=text],#rsvp-form input[type=tel]{width:100%;background:#f0f8ff;border:1.5px solid #bbdefb;border-radius:10px;color:#1a237e;font-family:'Quicksand',sans-serif;font-size:14px;font-weight:600;padding:10px 14px;outline:none;-webkit-appearance:none;transition:border-color .2s;}
#rsvp-form input:focus{border-color:#1976d2;}
.field-err{font-family:'Quicksand',sans-serif;font-size:11px;color:#e53935;font-weight:600;display:none;margin-top:3px;}
.field-err.show{display:block;}
.stepper{display:flex;align-items:center;gap:0;background:#f0f8ff;border:1.5px solid #bbdefb;border-radius:10px;overflow:hidden;width:fit-content;}
.step-btn{background:none;border:none;width:40px;height:40px;font-size:22px;font-weight:700;color:#1976d2;cursor:pointer;font-family:'Nunito',sans-serif;line-height:1;}
.step-btn:active{background:#bbdefb;}
#guest-count{font-family:'Nunito',sans-serif;font-size:18px;font-weight:800;color:#1a237e;min-width:36px;text-align:center;}
.attend-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:2px;}
.att-btn{background:#f0f8ff;border:1.5px solid #bbdefb;border-radius:10px;padding:10px 8px;font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:#1565c0;cursor:pointer;transition:all .2s;text-align:center;}
.att-btn:active,.att-btn.selected{background:#1976d2;border-color:#1976d2;color:#fff;}
.att-no{grid-column:1/-1;}
.att-btn.selected-no{background:#ef9a9a;border-color:#ef9a9a;color:#b71c1c;}
</style>
<script>
var guests=1;
var attend='';

function changeGuests(d){
  guests=Math.max(1,Math.min(20,guests+d));
  document.getElementById('guest-count').textContent=guests;
}

function selectAtt(v){
  attend=v;
  ['yes','maybe','no'].forEach(function(a){
    var b=document.getElementById('att-'+a);
    b.classList.remove('selected','selected-no');
  });
  var btn=document.getElementById('att-'+v);
  if(v==='no') btn.classList.add('selected-no');
  else btn.classList.add('selected');
  document.getElementById('err-att').classList.remove('show');
}

function submitRSVP(){
  var name=document.getElementById('f-name').value.trim();
  var ok=true;

  if(!name){document.getElementById('err-name').classList.add('show');ok=false;}
  else{document.getElementById('err-name').classList.remove('show');}

  if(!attend){document.getElementById('err-att').classList.add('show');ok=false;}

  if(!ok) return;

  var attLabel=attend==='yes'?'Yes, we will be there!':attend==='maybe'?'Maybe — will confirm soon':'Regretfully unable to attend';
  var msg='Hi Vipul & Divya! Here is my RSVP for Advik\'s 1 Month Celebration:\n\n'
    +'Name: '+name+'\n'
    +'Guests: '+guests+(guests===1?' person':' people')+'\n'
    +'Attending: '+attLabel+'\n\n'
    +'Can\'t wait to celebrate little Advik!';

  var conf={
    yes:{icon:'',title:'See you there!',sub:'Thank you '+name+'! We\'re so excited to celebrate with you'+(guests>1?' and your '+(guests-1)+' guest'+(guests>2?'s':'')+'.':'.')},
    maybe:{icon:'',title:'Noted!',sub:'Thanks '+name+'! We hope you can make it. Please let us know soon.'},
    no:{icon:'',title:'We\'ll miss you!',sub:'Thanks for letting us know, '+name+'. We\'ll save you a slice of cake!'}
  };

  document.getElementById('rsvp-form').style.display='none';
  var c=conf[attend];
  document.getElementById('conf-icon').textContent=c.icon;
  document.getElementById('conf-title').textContent=c.title;
  document.getElementById('conf-sub').textContent=c.sub;
  document.getElementById('rsvp-conf').style.display='block';

  setTimeout(function(){
    window.open('https://wa.me/642102557754?text='+encodeURIComponent(msg),'_blank');
  },600);
}

function resetForm(){
  attend='';guests=1;
  document.getElementById('f-name').value='';
  document.getElementById('guest-count').textContent='1';
  ['yes','maybe','no'].forEach(function(a){document.getElementById('att-'+a).classList.remove('selected','selected-no');});
  document.getElementById('rsvp-conf').style.display='none';
  document.getElementById('rsvp-form').style.display='block';
}
</script>
</body>
</html>
