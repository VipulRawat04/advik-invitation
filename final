          <div class="stepper">
            <button type="button" class="step-btn" onclick="changeGuests(-1)">−</button>
            <span id="guest-count">1</span>
            <button type="button" class="step-btn" onclick="changeGuests(1)">+</button>
          </div>
        </div>
        <div class="field-wrap">
          <label class="field-lbl">Will you be joining us?</label>
          <div class="attend-grid">
            <button type="button" class="att-btn" id="att-yes" onclick="selectAtt('yes')">Yes, we'll be there!</button>
            <button type="button" class="att-btn" id="att-maybe" onclick="selectAtt('maybe')">Maybe</button>
            <button type="button" class="att-btn att-no" id="att-no" onclick="selectAtt('no')">Can't make it</button>
          </div>
          <span class="field-err" id="err-att">Please select an option</span>
        </div>
        <button class="wa-btn" type="button" onclick="submitRSVP()">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:22px;height:22px;fill:#fff;flex-shrink:0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Send RSVP via WhatsApp
        </button>
      </div>

      <!-- CONFIRMATION -->
      <div id="rsvp-conf" style="display:none;text-align:center;padding:1rem 0 .5rem;">
        <div style="font-size:48px;margin-bottom:8px;" id="conf-icon"></div>
        <div style="font-family:'Nunito',sans-serif;font-size:20px;font-weight:800;color:#1565c0;margin-bottom:6px;" id="conf-title"></div>
        <div style="font-family:'Quicksand',sans-serif;font-size:13px;color:#5c7fa8;line-height:1.6;" id="conf-sub"></div>
        <button onclick="resetForm()" style="margin-top:14px;background:none;border:1.5px solid #90caf9;border-radius:20px;padding:6px 18px;font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:#1565c0;cursor:pointer;letter-spacing:1px;">Edit my RSVP</button>
