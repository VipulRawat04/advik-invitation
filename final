<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<title>Advik's 1 Month Celebration</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#c9e8f7;display:flex;justify-content:center;align-items:flex-start;min-height:100vh;padding:24px 12px;font-family:'Quicksand',sans-serif;}

.card{width:100%;max-width:420px;background:#f0f8ff;border-radius:28px;overflow:hidden;border:3px solid #a8d8f0;box-shadow:0 12px 50px rgba(56,139,202,0.18);}

/* ── BANNER ── */
.banner{position:relative;height:300px;overflow:hidden;background:#1a6fa8;}
.banner-sky{position:absolute;inset:0;background:#1a6fa8;}

.cloud{position:absolute;background:#e8f4fd;border-radius:50px;}
.c1{width:90px;height:36px;top:18px;left:20px;opacity:.55;}
.c2{width:60px;height:24px;top:22px;left:60px;opacity:.55;}
.c3{width:70px;height:28px;top:14px;right:30px;opacity:.45;}
.c4{width:50px;height:20px;top:18px;right:55px;opacity:.45;}
.c5{width:110px;height:40px;top:55px;left:-10px;opacity:.3;}
.c6{width:80px;height:30px;top:60px;right:10px;opacity:.3;}

.stars{position:absolute;top:0;left:0;right:0;height:120px;}

.moon{position:absolute;top:12px;right:22px;width:44px;height:44px;background:#fffde7;border-radius:50%;}
.moon::after{content:'';position:absolute;top:2px;right:2px;width:36px;height:36px;background:#1a6fa8;border-radius:50%;}

.grass-strip{position:absolute;bottom:0;left:0;right:0;height:80px;background:#5bb86a;}
.grass-strip::before{content:'';position:absolute;top:-18px;left:0;right:0;height:22px;background:#5bb86a;
  clip-path:polygon(0% 100%,2% 0%,4% 100%,6% 20%,8% 100%,10% 10%,12% 100%,14% 30%,16% 100%,18% 0%,20% 100%,22% 15%,24% 100%,26% 5%,28% 100%,30% 25%,32% 100%,34% 0%,36% 100%,38% 20%,40% 100%,42% 10%,44% 100%,46% 30%,48% 100%,50% 0%,52% 100%,54% 15%,56% 100%,58% 5%,60% 100%,62% 25%,64% 100%,66% 0%,68% 100%,70% 20%,72% 100%,74% 10%,76% 100%,78% 30%,80% 100%,82% 0%,84% 100%,86% 15%,88% 100%,90% 5%,92% 100%,94% 25%,96% 100%,98% 0%,100% 100%);}

.title-block{position:absolute;top:0;left:0;right:0;display:flex;flex-direction:column;align-items:center;padding:22px 20px 0;z-index:10;pointer-events:none;}
.eyebrow{font-family:'Nunito',sans-serif;font-size:11px;font-weight:700;letter-spacing:4px;color:#b3e5fc;text-transform:uppercase;}
.hero-name{font-family:'Nunito',sans-serif;font-size:58px;font-weight:900;line-height:.95;text-transform:uppercase;color:#fff;text-shadow:0 3px 0 #0d4f80,0 6px 20px rgba(0,0,0,0.3);}
.hero-name span{color:#ffe082;}
.hero-sub{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;letter-spacing:3px;color:#b3e5fc;text-transform:uppercase;margin-top:5px;}
.month-badge{background:#ffe082;color:#5c3d00;font-family:'Nunito',sans-serif;font-size:13px;font-weight:900;letter-spacing:1px;padding:4px 18px;border-radius:30px;margin-top:8px;display:inline-block;}

/* animals row */
.animals{position:absolute;bottom:0;left:0;right:0;height:80px;display:flex;align-items:flex-end;justify-content:space-around;padding:0 10px;z-index:5;}

/* ── DIVIDER ── */
.wave-divider{background:#2980b9;height:8px;position:relative;}
.wave-divider::after{content:'';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:36px;height:36px;background:#ffe082;border-radius:50%;display:flex;align-items:center;justify-content:center;line-height:36px;text-align:center;font-size:18px;}

/* ── BODY ── */
.body{padding:1.2rem 1.4rem;background:#f0f8ff;}
.invite-lbl{font-family:'Nunito',sans-serif;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#90caf9;text-align:center;margin-bottom:1rem;}

/* detail cards */
.dg{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:1rem;}
.dc{background:#fff;border:1.5px solid #bbdefb;border-radius:14px;padding:10px 12px;display:flex;align-items:flex-start;gap:9px;}
.dc.full{grid-column:1/-1;}
.dic{width:32px;height:32px;background:#1976d2;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.dic svg{width:16px;height:16px;stroke:#fff;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.dl{font-family:'Nunito',sans-serif;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#1976d2;display:block;margin-bottom:1px;font-weight:700;}
.dv{font-family:'Quicksand',sans-serif;font-size:13px;font-weight:700;color:#1a237e;display:block;line-height:1.3;}
.ds{font-family:'Quicksand',sans-serif;font-size:11px;font-weight:500;color:#90caf9;display:block;}

/* hosts */
.hosts{text-align:center;padding:.8rem 0;border-top:1.5px dashed #bbdefb;border-bottom:1.5px dashed #bbdefb;margin-bottom:1.2rem;}
.hl{font-family:'Nunito',sans-serif;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:#90caf9;font-weight:700;}
.hn{font-family:'Nunito',sans-serif;font-size:19px;font-weight:800;color:#1565c0;letter-spacing:.5px;}

/* rsvp */
.rbox{background:#fff;border:2px solid #90caf9;border-radius:16px;padding:1rem 1.2rem;}
.rh{display:flex;align-items:center;gap:7px;margin-bottom:.8rem;}
.rt{font-family:'Nunito',sans-serif;font-size:14px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#1565c0;}
.rb{margin-left:auto;background:#ffe082;color:#5c3d00;font-family:'Nunito',sans-serif;font-size:9px;font-weight:800;letter-spacing:1px;padding:3px 8px;border-radius:20px;text-transform:uppercase;}

.rsvp-info{font-family:'Quicksand',sans-serif;font-size:13px;color:#5c7fa8;line-height:1.6;margin-bottom:1rem;text-align:center;font-weight:500;}
.rsvp-info strong{color:#1565c0;}

.wa-btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;background:#25D366;border:none;border-radius:12px;color:#fff;font-family:'Nunito',sans-serif;font-size:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase;padding:14px;cursor:pointer;text-decoration:none;margin-top:4px;-webkit-tap-highlight-color:transparent;}
.wa-btn:active{background:#1ebe5d;}
.wa-btn svg{width:22px;height:22px;fill:#fff;flex-shrink:0;}

.crow{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:10px;font-family:'Quicksand',sans-serif;font-size:12px;color:#90caf9;letter-spacing:1px;font-weight:600;}
.crow a{color:#1565c0;text-decoration:none;font-weight:700;}

/* footer */
.footer{background:#1565c0;padding:12px 1.6rem;display:flex;align-items:center;justify-content:center;gap:10px;}
.fl{flex:1;height:1px;background:rgba(179,229,252,.3);}
.ft{font-family:'Nunito',sans-serif;font-size:10px;letter-spacing:3px;color:#b3e5fc;text-transform:uppercase;font-weight:700;white-space:nowrap;}

/* paw prints decoration */
.paw-row{display:flex;justify-content:center;gap:18px;margin:8px 0 12px;opacity:.3;}
</style>
</head>
