      <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="9" cy="6" r="3" fill="#90caf9"/><circle cx="15" cy="6" r="3" fill="#90caf9"/><circle cx="5" cy="12" r="2.5" fill="#90caf9"/><circle cx="19" cy="12" r="2.5" fill="#90caf9"/><ellipse cx="12" cy="17" rx="6" ry="5" fill="#90caf9"/></svg>
